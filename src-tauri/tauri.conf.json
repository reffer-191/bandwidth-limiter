{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandwidth Limiter",
  "version": "0.4.0",
  "identifier": "com.fer.bandwidthlimiter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "windivert/WinDivert.dll": "WinDivert.dll",
      "windivert/WinDivert64.sys": "WinDivert64.sys",
      "windivert/LICENSE": "WinDivert-LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./installer-hooks.nsh",
        "languages": [
          "Spanish",
          "English"
        ],
        "displayLanguageSelector": true
      },
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    },
    "publisher": "Fer",
    "shortDescription": "Bandwidth limiter and traffic monitor",
    "longDescription": "Per-application bandwidth limiter and network traffic monitor for Windows."
  }
}